# Copy to .env and adjust. Never commit .env.

# HTTP port for `python -m app` (binds to 127.0.0.1). Usually set by the reverse proxy.
# PORT=8000

# General
OMNI_TIMEZONE=Europe/Zagreb
OMNI_CACHE_TTL_SECONDS=600
OMNI_PROVIDER_TIMEOUT_SECONDS=20
OMNI_DEFAULT_HORIZON_DAYS=14

# Comma-separated list of provider keys to enable.
# Real clubs:  mladost  (HATK Mladost, Playloc; no login needed)
#              maksimir (TC Maksimir, Sporty.plus; no login needed)
#              zagi     (TK Zagi, Tivazerra; no login needed)
# Dev mocks:   mock_salata, mock_jarun, mock_broken (always fails; for testing error display)
OMNI_ENABLED_PROVIDERS=mladost,maksimir,zagi

# Per-provider credentials (Phase 2). Convention: OMNI_<PROVIDERKEY>_USERNAME / _PASSWORD
# OMNI_EXAMPLECLUB_USERNAME=
# OMNI_EXAMPLECLUB_PASSWORD=
